datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SubmissionStatus {
  pending
  verified
  rejected
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  wallet_address String       @unique
  created_at     DateTime     @default(now())
  submissions    Submission[]

  @@index([wallet_address])
}

model Submission {
  id                   String           @id @default(uuid()) @db.Uuid
  user_id              String           @db.Uuid
  user                 User             @relation(fields: [user_id], references: [id])
  photo_url            String
  ipfs_hash            String?
  latitude             Float
  longitude            Float
  status               SubmissionStatus @default(pending)
  verification_status  String?
  created_at           DateTime         @default(now())
  verification         Verification?
  credit               Credit?
  audit_events         AuditEvent[]

  @@index([status])
  @@index([user_id])
}

model Verification {
  id               String     @id @default(uuid()) @db.Uuid
  submission_id    String     @unique @db.Uuid
  submission       Submission @relation(fields: [submission_id], references: [id])
  ndvi_score       Float?
  photo_confidence Float?
  reasoning        String?    @db.Text
  verified_at      DateTime   @default(now())
}

model Credit {
  id            String     @id @default(uuid()) @db.Uuid
  submission_id String     @unique @db.Uuid
  submission    Submission @relation(fields: [submission_id], references: [id])
  token_id      String?
  tx_hash       String?
  minted_at     DateTime   @default(now())
}

model AuditEvent {
  id            String     @id @default(uuid()) @db.Uuid
  submission_id String     @db.Uuid
  submission    Submission @relation(fields: [submission_id], references: [id])
  action        String   // e.g. "submission_created", "verification_passed",
                          // "verification_failed", "mint_attempted", "mint_succeeded",
                          // "mint_failed"
  actor         String?  // wallet address if known, "system" if automated
  detail        Json?    // structured extra context: ndvi_score, photo_confidence,
                          // reasoning, tx_hash, error message, etc.
  created_at    DateTime @default(now())

  @@index([submission_id])
  @@index([action])
}
